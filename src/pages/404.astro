---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o fue movida.">
  <div class="container mx-auto px-4 py-24 max-w-2xl text-center">
    <h1 class="text-6xl font-bold text-gray-900 dark:text-white mb-4">404</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">La página que buscas no existe o fue movida.</p>
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-md font-medium transition-colors bg-orange-600 text-white hover:bg-orange-700 h-12 px-6 text-lg"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>
