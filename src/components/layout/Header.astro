---
import HerramientasDropdown from './HerramientasDropdown.astro';
import { X, ChevronRight, Sun, Moon } from 'lucide-react';

const navItems = [
  { path: '/', label: 'Inicio' },
  { path: '/aprende', label: 'Aprende' },
  { path: '/contacto', label: 'Contacto' },
];

const herramientasItems = [
  { path: '/salud-financiera', label: 'Salud Financiera' },
  { path: '/proyeccion-crediticia', label: 'Proyección Crediticia' },
];

const isActive = (path: string) =>
  path === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(path);

const isAnyHerramientaActive = herramientasItems.some((item) => Astro.url.pathname.startsWith(item.path));
---

<header class="sticky top-0 z-50 w-full border-b bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/60 dark:bg-gray-900/95 dark:supports-[backdrop-filter]:bg-gray-900/60">
  <div class="container mx-auto px-3 sm:px-4 max-w-7xl">
    <div class="flex h-16 items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-2 text-lg sm:text-xl font-semibold tracking-tight text-gray-900 dark:text-white transition-colors"
      >
        <svg viewBox="0 0 32 32" fill="none" class="h-7 w-7 flex-shrink-0" aria-hidden="true">
          <rect width="32" height="32" rx="8" class="fill-orange-600" />
          <path d="M8 21V11l8 7 8-7v10" stroke="#fff7ed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>METIS <span class="text-orange-600 dark:text-orange-400">Finanzas</span></span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-0.5 space-x-1">
        {
          navItems.map((item) => (
            <a
              href={item.path}
              class:list={[
                'px-4 py-2 rounded-md text-sm font-medium transition-colors whitespace-nowrap',
                isActive(item.path)
                  ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400'
                  : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <HerramientasDropdown items={herramientasItems} />

        <!-- Theme Toggle Button -->
        <button
          type="button"
          data-theme-toggle
          class="ml-2 p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition-colors"
          aria-label="Cambiar tema"
          title="Cambiar tema"
        >
          <span class="hidden dark:block"><Sun className="h-5 w-5" /></span>
          <span class="block dark:hidden"><Moon className="h-5 w-5" /></span>
        </button>
      </nav>

      <!-- Mobile Menu Buttons -->
      <div class="md:hidden flex items-center gap-2">
        <button
          type="button"
          data-theme-toggle
          class="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition-colors"
          aria-label="Cambiar tema"
          title="Cambiar tema"
        >
          <span class="hidden dark:block"><Sun className="h-5 w-5" /></span>
          <span class="block dark:hidden"><Moon className="h-5 w-5" /></span>
        </button>
        <button
          type="button"
          data-mobile-menu-toggle
          class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition-colors font-medium"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <span data-mobile-menu-icon-close class="hidden"><X className="h-6 w-6" /></span>
          <span data-mobile-menu-label>Menú</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Sidebar -->
<div
  data-mobile-sidebar
  class="fixed inset-0 z-50 md:hidden transition-transform duration-300 ease-in-out translate-x-full"
>
  <!-- Overlay -->
  <div data-mobile-sidebar-overlay class="absolute inset-0 bg-black/50 dark:bg-black/70" />

  <!-- Sidebar -->
  <div class="absolute left-0 top-0 h-full w-full bg-white dark:bg-gray-900 shadow-xl flex flex-col">
    <!-- Sidebar Header -->
    <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-800">
      <a href="/" data-mobile-sidebar-link class="flex items-center gap-2 text-xl font-semibold tracking-tight text-gray-900 dark:text-white">
        <svg viewBox="0 0 32 32" fill="none" class="h-7 w-7 flex-shrink-0" aria-hidden="true">
          <rect width="32" height="32" rx="8" class="fill-orange-600" />
          <path d="M8 21V11l8 7 8-7v10" stroke="#fff7ed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>METIS <span class="text-orange-600 dark:text-orange-400">Finanzas</span></span>
      </a>
      <button
        type="button"
        data-mobile-sidebar-close
        class="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition-colors"
        aria-label="Cerrar menú"
      >
        <X className="h-6 w-6" />
      </button>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="flex-1 overflow-y-auto p-4">
      <div class="space-y-1">
        {
          navItems.map((item) => (
            <a
              href={item.path}
              data-mobile-sidebar-link
              class:list={[
                'flex items-center justify-between px-4 py-3 rounded-md text-base font-medium transition-colors',
                isActive(item.path)
                  ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400'
                  : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100',
              ]}
            >
              <span>{item.label}</span>
              {isActive(item.path) && <ChevronRight className="h-5 w-5" />}
            </a>
          ))
        }

        <!-- Herramientas Section -->
        <div class="pt-2">
          <div
            class:list={[
              'px-4 py-3 rounded-md text-base font-medium',
              isAnyHerramientaActive
                ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400'
                : 'text-gray-700 dark:text-gray-300',
            ]}
          >
            Herramientas
          </div>
          <div class="pl-4 mt-1 space-y-1">
            {
              herramientasItems.map((item) => {
                const isActiveItem = Astro.url.pathname.startsWith(item.path);
                return (
                  <a
                    href={item.path}
                    data-mobile-sidebar-link
                    class:list={[
                      'flex items-center justify-between px-4 py-3 rounded-md text-sm transition-colors',
                      isActiveItem
                        ? 'bg-orange-50 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400'
                        : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100',
                    ]}
                  >
                    <span>{item.label}</span>
                    {isActiveItem && <ChevronRight className="h-4 w-4" />}
                  </a>
                );
              })
            }
          </div>
        </div>

        <!-- Theme Toggle in Mobile Menu -->
        <div class="pt-4 border-t border-gray-200 dark:border-gray-800 mt-4">
          <button
            type="button"
            data-theme-toggle
            class="flex items-center justify-between w-full px-4 py-3 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition-colors"
          >
            <span class="hidden dark:inline">Modo claro</span>
            <span class="inline dark:hidden">Modo oscuro</span>
            <span class="hidden dark:block"><Sun className="h-5 w-5" /></span>
            <span class="block dark:hidden"><Moon className="h-5 w-5" /></span>
          </button>
        </div>
      </div>
    </nav>
  </div>
</div>

<script>
  const THEME_STORAGE_KEY = 'metis-finanzas-theme';

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', isDark);
      localStorage.setItem(THEME_STORAGE_KEY, isDark ? 'dark' : 'light');
    });
  });

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const sidebar = document.querySelector<HTMLElement>('[data-mobile-sidebar]');
  const menuIconClose = document.querySelector<HTMLElement>('[data-mobile-menu-icon-close]');
  const menuLabel = document.querySelector<HTMLElement>('[data-mobile-menu-label]');

  const setMobileMenuOpen = (open: boolean) => {
    if (!sidebar || !menuToggle) return;
    sidebar.classList.toggle('translate-x-full', !open);
    sidebar.classList.toggle('translate-x-0', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuIconClose?.classList.toggle('hidden', !open);
    menuLabel?.classList.toggle('hidden', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  menuToggle?.addEventListener('click', () => {
    setMobileMenuOpen(sidebar?.classList.contains('translate-x-full') ?? false);
  });

  document.querySelector('[data-mobile-sidebar-close]')?.addEventListener('click', () => setMobileMenuOpen(false));
  document.querySelector('[data-mobile-sidebar-overlay]')?.addEventListener('click', () => setMobileMenuOpen(false));
  document.querySelectorAll('[data-mobile-sidebar-link]').forEach((link) => {
    link.addEventListener('click', () => setMobileMenuOpen(false));
  });
</script>
