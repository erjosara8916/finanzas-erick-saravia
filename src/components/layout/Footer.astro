---
const copyrightOwner = 'Erick Saravia';
const copyrightYear = new Date().getFullYear();
const ownerWebsite = 'https://resume.ericksaravia.com/';
---

<footer class="relative md:fixed md:bottom-0 left-0 right-0 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 z-40 mt-auto">
  <div class="container mx-auto px-4 py-4 max-w-7xl">
    <div class="flex flex-col sm:flex-row items-center justify-center md:justify-center gap-3 text-sm text-gray-600 dark:text-gray-400">
      <svg viewBox="0 0 32 32" fill="none" class="h-5 w-5 flex-shrink-0" aria-hidden="true">
        <rect width="32" height="32" rx="8" class="fill-orange-600" />
        <path d="M8 21V11l8 7 8-7v10" stroke="#fff7ed" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div class="text-center">
        © {copyrightYear}{' '}
        <a
          href={ownerWebsite}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 underline transition-colors"
        >
          {copyrightOwner}
        </a>
        . Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>
