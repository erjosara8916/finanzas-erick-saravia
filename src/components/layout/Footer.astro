---
const copyrightOwner = 'Erick Saravia';
const copyrightYear = new Date().getFullYear();
const ownerWebsite = 'https://resume.ericksaravia.com/';
---

<footer class="relative md:fixed md:bottom-0 left-0 right-0 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 z-40 mt-auto">
  <div class="container mx-auto px-4 py-4 max-w-7xl">
    <div class="flex flex-col sm:flex-row items-center justify-center md:justify-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <div class="text-center">
        © {copyrightYear}{' '}
        <a
          href={ownerWebsite}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 underline transition-colors"
        >
          {copyrightOwner}
        </a>
        . Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>
